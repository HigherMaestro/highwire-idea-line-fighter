# Copy this file to .env (which git ignores) and fill it in. Everything here is optional.

# A Solana RPC from a provider (Helius, Triton, QuickNode and others have free tiers). The public RPC works, but it
# rate-limits an agent that runs all day. The URL often carries an API key: keep it in .env, never in the code.
SOLANA_RPC_URL=
